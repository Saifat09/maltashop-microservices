{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderPlaced v1 - as required by inventory-service",
  "type": "object",
  "required": ["event_id", "event_type", "version", "correlation_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"const": "OrderPlaced"},
    "version": {"const": 1},
    "correlation_id": {"type": "string"},
    "payload": {
      "type": "object",
      "required": ["order_id", "lines"],
      "properties": {
        "order_id": {"type": "string"},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "properties": {
              "sku": {"type": "string"},
              "quantity": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  },
  "examples": [{
    "event_id": "6f1c1f9e-0000-4000-8000-000000000001",
    "event_type": "OrderPlaced",
    "version": 1,
    "correlation_id": "contract-example",
    "payload": {"order_id": "ord-contract-1", "lines": [{"sku": "KETTLE-1L", "quantity": 2}]}
  }]
}
