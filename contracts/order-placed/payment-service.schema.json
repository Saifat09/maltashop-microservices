{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderPlaced v1 - as required by payment-service",
  "type": "object",
  "required": ["event_id", "event_type", "version", "payload"],
  "properties": {
    "event_type": {"const": "OrderPlaced"},
    "version": {"const": 1},
    "payload": {
      "type": "object",
      "required": ["order_id", "total_cents", "currency", "payment_token"],
      "properties": {
        "order_id": {"type": "string"},
        "total_cents": {"type": "integer", "minimum": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "payment_token": {"type": "string", "pattern": "^tok_"}
      }
    }
  },
  "examples": [{
    "event_id": "6f1c1f9e-0000-4000-8000-000000000002",
    "event_type": "OrderPlaced",
    "version": 1,
    "correlation_id": "contract-example",
    "payload": {"order_id": "ord-contract-2", "total_cents": 4998, "currency": "EUR", "payment_token": "tok_visa_ok"}
  }]
}
